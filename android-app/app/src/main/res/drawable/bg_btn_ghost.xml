<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1A00E5FF"/>
            <stroke android:width="1dp" android:color="@color/accent"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/panel"/>
            <stroke android:width="1dp" android:color="@color/card_border"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/panel"/>
            <stroke android:width="1dp" android:color="@color/accent_dim"/>
            <corners android:radius="10dp"/>
        </shape>
    </item>
</selector>
